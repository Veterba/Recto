{
  "name": "recto",
  "version": "0.9.3",
  "description": "Local-first, markdown-on-disk knowledge app",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "app": "npm run dist:dir && node build/install-app.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsc --noEmit && vitest run",
    "postinstall": "electron-rebuild -f -w better-sqlite3,onnxruntime-node",
    "rebuild": "electron-rebuild -f -w better-sqlite3,onnxruntime-node",
    "test:e2e": "electron-vite build && RECTO_E2E=1 vitest run test/e2e",
    "snapshots": "electron-vite build && node scripts/snapshots.mjs",
    "bots:eval": "electron-vite build && node --disable-warning=ExperimentalWarning scripts/evals/run.ts",
    "bots:eval:compare": "node --disable-warning=ExperimentalWarning scripts/evals/compare.ts",
    "bots:eval:rescore": "node --disable-warning=ExperimentalWarning scripts/evals/rescore.ts",
    "vault:tidy": "node --disable-warning=ExperimentalWarning scripts/vault-tidy.ts"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3-force": "^3.0.10",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@huggingface/transformers": "^4.3.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@replit/codemirror-vim": "^6.4.0",
    "az": "^0.2.3",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "compromise": "^14.17.0",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "katex": "^0.16.47",
    "lucide-react": "^1.45.0",
    "onnxruntime-node": "1.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
