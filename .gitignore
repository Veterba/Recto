# --- dependencies ---
node_modules/

# --- build output ---
# electron-vite compiles here; regenerated by `npm run build`, never edited by hand.
out/
# electron-builder puts installers here (milestone 8). These are hundreds of MB.
dist/
release/
*.dmg
*.zip
*.exe
*.AppImage
*.deb

# --- caches ---
.vite/
.cache/
coverage/
*.tsbuildinfo

# --- native modules ---
# better-sqlite3 (milestone 1.5) is compiled against Electron's ABI on this
# machine. The binary is not portable, so it is rebuilt on install everywhere.
*.node
build/Release/
prebuilds/

# --- secrets ---
# No key should ever reach this repo. The real API key lives in the OS keychain
# via safeStorage, outside the project entirely - this is belt and braces.
.env
.env.*
!.env.example
secrets.bin

# --- local vaults ---
# If you keep a scratch vault inside the repo while developing, name it this.
/vault/
/test-vault/

# --- editor / OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.log
npm-debug.log*
